# Build context hygiene — keep images small & reproducible
node_modules
.git
.gitignore
npm-debug.log*
yarn-error.log*
.pnpm-store
.cache
coverage

# Host build output — the image builds its own bundle
dist
build
out
.next

# Python artefacts (monorepo hygiene)
.venv
venv
__pycache__
*.pyc
.pytest_cache

# Secrets must never enter the build context
.env
.env.*

# Editor / docs / docker files
.vscode
.idea
*.md
Dockerfile
docker-compose.yml
.dockerignore
