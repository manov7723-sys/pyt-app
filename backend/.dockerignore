# Build context hygiene — keep the image small and reproducible.
.git
.gitignore
node_modules
npm-debug.log*
yarn-error.log*
.pnpm-store

# Python: a developer's virtualenv and caches must never enter the image —
# `COPY . .` would ship a host-built .venv the container cannot use.
.venv
venv
__pycache__
*.pyc
.pytest_cache
.mypy_cache
.ruff_cache
.tox

# Build output
dist
build
out
.cache
coverage

# Secrets stay out of the build context entirely.
.env
.env.*

# Editor/docs noise
*.md
.vscode
.idea

# Docker files themselves don't belong in the context.
Dockerfile
docker-compose.yml
.dockerignore
